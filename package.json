{
  "name": "weft-context",
  "version": "0.1.0",
  "private": false,
  "description": "Shared, versioned context for parallel coding agents.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {"node": ">=24.0.0"},
  "bin": {"weft": "dist/cli/index.js"},
  "exports": {".": "./dist/core/index.js", "./types": "./dist/core/types.js"},
  "files": ["dist", "README.md", "LICENSE", "examples"],
  "scripts": {
    "dev": "tsx src/cli/index.ts serve --dev",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "tsc -p tsconfig.build.json && vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web/tsconfig.json",
    "start": "node dist/cli/index.js serve",
    "weft": "tsx src/cli/index.ts",
    "smoke": "tsx scripts/smoke.ts",
    "mcp": "tsx src/mcp/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^14.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0",
    "vite": "^8.3.0"
  }
}
