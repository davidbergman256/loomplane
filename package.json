{
  "name": "loomplane",
  "version": "0.3.0",
  "private": false,
  "description": "Shared, versioned context for parallel coding agents.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "loomplane": "dist/cli/index.js"
  },
  "exports": {
    ".": "./dist/core/index.js",
    "./types": "./dist/core/types.js",
    "./sdk": "./dist/sdk/index.js",
    "./runner": "./dist/runner/run.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "examples",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "tsx src/cli/index.ts serve --dev",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "tsc -p tsconfig.build.json && vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web/tsconfig.json",
    "start": "node dist/cli/index.js serve",
    "loomplane": "tsx src/cli/index.ts",
    "smoke": "tsx scripts/smoke.ts",
    "mcp": "tsx src/mcp/index.ts",
    "smoke:integrations": "tsx scripts/integration-smoke.ts",
    "smoke:lifecycle": "tsx scripts/lifecycle-smoke.ts",
    "smoke:sources": "tsx scripts/source-smoke.ts",
    "smoke:sdk": "tsx scripts/sdk-smoke.ts",
    "smoke:portable": "tsx scripts/portable-smoke.ts",
    "smoke:access": "tsx scripts/access-smoke.ts",
    "smoke:remote": "tsx scripts/remote-mcp-smoke.ts",
    "format": "prettier --write src apps/web/src scripts examples/sdk docs README.md CONTRIBUTING.md SECURITY.md AGENTS.md package.json",
    "prepack": "npm run build",
    "smoke:diff": "tsx scripts/packet-diff-smoke.ts",
    "smoke:runner": "tsx scripts/runner-smoke.ts",
    "smoke:consistency": "tsx scripts/consistency-smoke.ts",
    "smoke:idempotency": "tsx scripts/idempotency-store-smoke.ts && tsx scripts/idempotency-http-smoke.ts",
    "smoke:remote-runner": "tsx scripts/remote-runner-smoke.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "smoke:workspace": "tsx scripts/workspace-smoke.ts && tsx scripts/workspace-http-smoke.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^14.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "prettier": "^3.9.8",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0",
    "vite": "^8.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidbergman256/loomplane.git"
  },
  "homepage": "https://github.com/davidbergman256/loomplane#readme",
  "bugs": {
    "url": "https://github.com/davidbergman256/loomplane/issues"
  },
  "keywords": [
    "context-engineering",
    "coding-agents",
    "mcp",
    "parallel-agents",
    "developer-tools"
  ]
}
